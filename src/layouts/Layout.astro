---
import "../styles/global.css";
import Header from "../components/Header.astro";
import Footer from "../components/Footer.astro";
import MobileCallBar from "../components/MobileCallBar.astro";
import { business } from "../data/content";

interface Props {
  title?: string;
  description?: string;
}

const {
  title = `${business.name} | Plumbing & Heating in Montgomery County, PA`,
  description = `Full-service plumbing and heating in Montgomery, Philadelphia, Chester, and Bucks Counties. Call ${business.phone} for repairs, remodels, and tankless water heaters.`,
} = Astro.props;

const schema = {
  "@context": "https://schema.org",
  "@type": "Plumber",
  name: business.name,
  telephone: business.phone,
  email: business.email,
  areaServed: [
    "Montgomery County, PA",
    "Philadelphia County, PA",
    "Chester County, PA",
    "Bucks County, PA",
  ],
  url: "https://www.spigelmyerplumbing.com",
};
---

<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <link rel="icon" type="image/png" href="/images/logos/logo-header.png" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=DM+Sans:wght@400;500;600;700&family=Instrument+Serif:ital@0;1&display=swap"
      rel="stylesheet"
    />
    <link rel="canonical" href={new URL(Astro.url.pathname, Astro.site)} />
    <meta property="og:title" content={title} /><meta property="og:description" content={description} /><meta property="og:type" content="website" /><title>{title}</title>
    <script type="application/ld+json" set:html={JSON.stringify(schema)} />
  </head>
  <body class="bg-gray-50 text-gray-900 antialiased">
    <a href="#main-content" class="skip-link">Skip to content</a>
    <Header />
    <main id="main-content">
      <slot />
    </main>
    <Footer />
    <MobileCallBar />
  </body>
</html>
