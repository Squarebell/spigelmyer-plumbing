---
import { resources } from "../data/content";
---

<section id="resources" class="bg-white py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="section-heading">Resources</h2>
    <p class="section-subheading">
      Trusted brands and suppliers we work with on your projects.
    </p>

    <div class="mt-10 grid gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        resources.map((resource) => (
          <a
            href={resource.url}
            target="_blank"
            rel="noopener noreferrer"
            class="group rounded-xl border border-gray-200 bg-gray-50 p-5 transition hover:border-brand-blue hover:bg-white hover:shadow-md"
          >
            <h3 class="font-semibold text-brand-blue group-hover:underline">
              {resource.name}
            </h3>
            <p class="mt-2 text-sm text-gray-600">{resource.description}</p>
            <p class="mt-2 text-xs text-gray-400">{resource.url.replace("https://www.", "")}</p>
          </a>
        ))
      }
    </div>
  </div>
</section>
