---
import { services } from "../data/content";
---

<section id="services" class="py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="section-heading">Services</h2>
    <p class="section-subheading">
      Full-service plumbing and hot water heating — from repairs to complete remodels.
    </p>

    <div class="mt-10 grid items-start gap-4 sm:grid-cols-2 lg:grid-cols-3">
      {
        services.map((service) => (
          <details class="service-card group w-full rounded-xl border border-gray-200 bg-white shadow-sm open:ring-2 open:ring-brand-blue/20">
            <summary class="service-card-summary cursor-pointer list-none p-5 font-semibold text-gray-900 marker:content-none">
              <div class="flex items-start justify-between gap-3">
                <span class="line-clamp-2 leading-snug">{service.title}</span>
                <svg
                  class="h-5 w-5 shrink-0 text-brand-blue transition group-open:rotate-180"
                  fill="none"
                  stroke="currentColor"
                  viewBox="0 0 24 24"
                >
                  <path
                    stroke-linecap="round"
                    stroke-linejoin="round"
                    stroke-width="2"
                    d="M19 9l-7 7-7-7"
                  />
                </svg>
              </div>
              <p class="service-card-subtitle mt-2 text-sm font-normal leading-5 text-gray-500">
                {service.subtitle ?? "\u00a0"}
              </p>
            </summary>
            <div class="border-t border-gray-100 px-5 pb-5 pt-3">
              {service.items.length > 0 ? (
                <ul>
                  {service.items.map((item) => (
                    <li class="flex gap-2 py-1 text-sm text-gray-600">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 rounded-full bg-brand-orange" />
                      {item}
                    </li>
                  ))}
                </ul>
              ) : (
                <p class="text-sm text-gray-600">
                  Contact us for sales, service, repairs and installation.
                </p>
              )}
            </div>
          </details>
        ))
      }
    </div>
  </div>
</section>

<style>
  details summary::-webkit-details-marker {
    display: none;
  }

  /* Same size when closed */
  .service-card:not([open]) {
    height: 7.5rem;
    overflow: hidden;
  }

  .service-card:not([open]) .service-card-summary {
    display: flex;
    height: 100%;
    flex-direction: column;
    justify-content: center;
  }

  .service-card:not([open]) .service-card-subtitle {
    min-height: 1.25rem;
  }

  /* Natural compact header when open */
  .service-card[open] .service-card-summary {
    display: block;
  }
</style>
