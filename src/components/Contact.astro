---
import { business, quoteJobTypes } from "../data/content";

const web3formsKey = import.meta.env.PUBLIC_WEB3FORMS_ACCESS_KEY ?? "";
---

<section id="contact" class="py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="section-heading">Let's take care of your home.</h2>
    <p class="section-subheading">
      Have a question or a project in mind? Call, text, or leave a message. Fields marked * are required.
    </p>

    <div class="mt-10 grid gap-8 lg:grid-cols-3">
      <div class="space-y-6">
        <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
          <h3 class="font-semibold text-gray-900">Get in Touch</h3>
          <dl class="mt-4 space-y-4 text-sm">
            <div>
              <dt class="font-medium text-gray-500">Phone</dt>
              <dd>
                <a href={business.phoneHref} class="text-lg font-semibold text-brand-orange hover:underline">
                  {business.phone}
                </a>
              </dd>
            </div>
            <div>
              <dt class="font-medium text-gray-500">Email</dt>
              <dd>
                <a href={`mailto:${business.email}`} class="text-brand-blue hover:underline">
                  {business.email}
                </a>
              </dd>
            </div>
          </dl>
        </div>
      </div>

      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm lg:col-span-1">
        <h3 class="font-semibold text-gray-900">Contact Form</h3>
        <form id="contact-form" class="mt-4 space-y-4">
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="Website Contact Form - Spigelmyer Plumbing" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

          <div>
            <label for="contact-name" class="form-label">Name *</label>
            <input type="text" id="contact-name" name="name" autocomplete="name" required class="form-input" />
          </div>
          <div>
            <label for="contact-email" class="form-label">Email *</label>
            <input type="email" id="contact-email" name="email" autocomplete="email" required class="form-input" />
          </div>
          <div>
            <label for="contact-phone" class="form-label">Phone</label>
            <input type="tel" id="contact-phone" name="phone" autocomplete="tel" class="form-input" />
          </div>
          <div>
            <label for="contact-message" class="form-label">Message *</label>
            <textarea id="contact-message" name="message" rows="4" required class="form-input"></textarea>
          </div>
          <div id="contact-result" role="status" aria-live="polite" class="hidden rounded-lg p-3 text-sm"></div>
          <button type="submit" class="btn-primary w-full">Send Message</button>
        </form>
      </div>

      <div class="rounded-xl border-2 border-brand-orange/30 bg-orange-50 p-6 shadow-sm lg:col-span-1">
        <h3 class="font-semibold text-gray-900">Request a Quote</h3>
        <p class="mt-1 text-sm text-gray-600">Tell us about your project and we'll get back to you.</p>
        <form id="quote-form" class="mt-4 space-y-4">
          <input type="hidden" name="access_key" value={web3formsKey} />
          <input type="hidden" name="subject" value="Quote Request - Spigelmyer Plumbing" />
          <input type="checkbox" name="botcheck" class="hidden" style="display:none" />

          <div>
            <label for="quote-name" class="form-label">Name *</label>
            <input type="text" id="quote-name" name="name" autocomplete="name" required class="form-input" />
          </div>
          <div>
            <label for="quote-phone" class="form-label">Phone *</label>
            <input type="tel" id="quote-phone" name="phone" autocomplete="tel" required class="form-input" />
          </div>
          <div>
            <label for="quote-email" class="form-label">Email</label>
            <input type="email" id="quote-email" name="email" autocomplete="email" class="form-input" />
          </div>
          <div>
            <label for="quote-type" class="form-label">Job Type *</label>
            <select id="quote-type" name="job_type" required class="form-input">
              <option value="">Select a job type...</option>
              {quoteJobTypes.map((type) => <option value={type}>{type}</option>)}
            </select>
          </div>
          <div>
            <label for="quote-description" class="form-label">Project Description *</label>
            <textarea id="quote-description" name="message" rows="3" required class="form-input" placeholder="Brief description of your project or issue"></textarea>
          </div>
          <div id="quote-result" role="status" aria-live="polite" class="hidden rounded-lg p-3 text-sm"></div>
          <button type="submit" class="btn-primary w-full">Request Quote</button>
        </form>
      </div>
    </div>
  </div>
</section>

<script>
  function handleFormSubmit(formId: string, resultId: string) {
    const form = document.getElementById(formId) as HTMLFormElement;
    const result = document.getElementById(resultId);

    form?.addEventListener("submit", async (e) => {
      e.preventDefault();
      const accessKey = (form.querySelector('[name="access_key"]') as HTMLInputElement)?.value;
      if (!accessKey) {
        if (result) {
          result.className = "rounded-lg bg-yellow-50 p-3 text-sm text-yellow-800";
          result.textContent = "Form is not configured yet. Please call us directly.";
          result.classList.remove("hidden");
        }
        return;
      }

      const btn = form.querySelector('[type="submit"]') as HTMLButtonElement;
      btn.disabled = true;
      btn.textContent = "Sending...";

      try {
        const response = await fetch("https://api.web3forms.com/submit", {
          method: "POST",
          headers: { "Content-Type": "application/json", Accept: "application/json" },
          body: JSON.stringify(Object.fromEntries(new FormData(form))),
        });
        const data = await response.json();

        if (result) {
          result.classList.remove("hidden");
          if (response.ok && data.success) {
            result.className = "rounded-lg bg-green-50 p-3 text-sm text-green-800";
            result.textContent = "Thank you! Your message has been sent.";
            form.reset();
          } else {
            result.className = "rounded-lg bg-red-50 p-3 text-sm text-red-800";
            result.textContent = "Something went wrong. Please call us directly.";
          }
        }
      } catch {
        if (result) {
          result.classList.remove("hidden");
          result.className = "rounded-lg bg-red-50 p-3 text-sm text-red-800";
          result.textContent = "Network error. Please call us directly.";
        }
      } finally {
        btn.disabled = false;
        btn.textContent = formId === "contact-form" ? "Send Message" : "Request Quote";
      }
    });
  }

  handleFormSubmit("contact-form", "contact-result");
  handleFormSubmit("quote-form", "quote-result");
</script>
