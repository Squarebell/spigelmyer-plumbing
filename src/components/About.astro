---
import { about } from "../data/content";
---

<section id="about" class="bg-white py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="section-heading">{about.title}</h2>
    <div class="mt-8 grid gap-8 lg:grid-cols-3">
      <div class="lg:col-span-2 space-y-4 text-gray-600 leading-relaxed">
        {about.paragraphs.map((p) => <p>{p}</p>)}
      </div>
      <div class="flex flex-col gap-4">
        {
          about.highlights.map((item) => (
            <div class="rounded-xl border border-gray-200 bg-gray-50 p-5 text-center">
              <p class="text-2xl font-bold text-brand-blue">{item.value}</p>
              <p class="mt-1 text-sm text-gray-600">{item.label}</p>
            </div>
          ))
        }
      </div>
    </div>
  </div>
</section>
