---
import { business } from "../data/content";

const mapQuery = encodeURIComponent("Montgomery County, PA");
const mapSrc = `https://maps.google.com/maps?q=${mapQuery}&t=&z=9&ie=UTF8&iwloc=&output=embed`;
---

<section id="service-area" class="py-16 md:py-20">
  <div class="mx-auto max-w-6xl px-4">
    <h2 class="section-heading">Service Area</h2>
    <p class="section-subheading">{business.serviceArea}</p>

    <div class="mt-10 grid gap-8 lg:grid-cols-2">
      <div class="rounded-xl border border-gray-200 bg-white p-6 shadow-sm">
        <h3 class="text-lg font-semibold text-gray-900">Counties We Serve</h3>
        <ul class="mt-4 space-y-2 text-gray-600">
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-brand-blue" />
            Montgomery County
          </li>
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-brand-blue" />
            Philadelphia County (select areas)
          </li>
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-brand-blue" />
            Chester County (select areas)
          </li>
          <li class="flex items-center gap-2">
            <span class="h-2 w-2 rounded-full bg-brand-blue" />
            Bucks County (select areas)
          </li>
        </ul>
        <div class="mt-6 border-t border-gray-100 pt-6">
          <a href={business.phoneHref} class="inline-block font-semibold text-brand-orange hover:underline">
            Call or text {business.phone}
          </a>
        </div>
      </div>

      <div class="overflow-hidden rounded-xl border border-gray-200 shadow-sm">
        <iframe
          title="Spigelmyer Plumbing service area map"
          src={mapSrc}
          class="h-80 w-full lg:h-full min-h-[320px]"
          loading="lazy"
          referrerpolicy="no-referrer-when-downgrade"></iframe>
      </div>
    </div>
  </div>
</section>
